# ---------------------------------------------------------------------------
# Trading Floor IA — variables d'environnement
# Copier ce fichier en .env.local et remplir. Aucune valeur réelle n'est
# commitée. Sur Vercel, ces variables se déclarent dans Project → Settings →
# Environment Variables.
# ---------------------------------------------------------------------------

# --- Supabase (obligatoire) -------------------------------------------------
# Tableau de bord Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# Clé publiable (anciennement « anon »). Exposée au navigateur, c'est normal :
# elle ne donne accès qu'à ce que les politiques RLS autorisent.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Clé service_role : contourne RLS. JAMAIS préfixée NEXT_PUBLIC_, jamais
# journalisée. Utilisée uniquement par les Route Handlers et Server Actions.
SUPABASE_SERVICE_ROLE_KEY=

# --- Chiffrement des clés API stockées en base (phase 1) --------------------
# 32 octets en base64. Génération : openssl rand -base64 32
CLE_CHIFFREMENT=

# --- Verrou du mode réel (phase 7) ------------------------------------------
# Laisser à "false". Le mode réel est en plus verrouillé par un trigger en base
# et par une constante TypeScript : les trois doivent être levés ensemble.
AUTORISER_MODE_REEL=false
# Plafond absolu, en dur côté serveur, pour le futur mode réel (USD).
PLAFOND_ABSOLU_REEL_USD=0

# ---------------------------------------------------------------------------
# Fournisseurs de données de marché (phase 1)
# Ces clés se saisissent normalement dans l'UI (Réglages → Fournisseurs) et
# sont chiffrées en base. Les variables ci-dessous ne servent qu'au
# développement local et aux tests d'intégration.
# ---------------------------------------------------------------------------
# https://twelvedata.com/pricing — palier gratuit ~800 requêtes/jour
TWELVEDATA_API_KEY=
# https://finnhub.io/register — ~60 appels/minute, WebSocket inclus
FINNHUB_API_KEY=
# https://www.alphavantage.co/support/#api-key — ~25 requêtes/jour
ALPHAVANTAGE_API_KEY=
# https://alpaca.markets/ — compte paper, aucune carte de crédit requise
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Yahoo Finance n'a pas d'API officielle ni de clé : endpoints non documentés,
# donc jamais en dépendance critique.

# ---------------------------------------------------------------------------
# Fournisseurs LLM (phase 4) — mêmes remarques : saisie dans l'UI en principe.
# ---------------------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
